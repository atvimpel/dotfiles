WorkingDirectory=/home/mari/.pcchat/workspaces/mwl3smbz44k9/uptime-kuma/uptime-kuma-src
Environment=UPTIME_KUMA_DATA_DIR=/home/mari/.pcchat/workspaces/mwl3smbz44k9/uptime-kuma/kuma-data/
