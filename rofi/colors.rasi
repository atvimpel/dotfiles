* {
    primary: #0052dc;
    primary-fixed: #dbe1ff;
    primary-fixed-dim: #b4c5ff;
    on-primary: #ffffff;
    on-primary-fixed: #00174b;
    on-primary-fixed-variant: #003da9;
    primary-container: #dbe1ff;
    on-primary-container: #00174b;
    secondary: #5c5b7d;
    secondary-fixed: #e3dfff;
    secondary-fixed-dim: #c5c2ea;
    on-secondary: #ffffff;
    on-secondary-fixed: #191836;
    on-secondary-fixed-variant: #454364;
    secondary-container: #e3dfff;
    on-secondary-container: #191836;
    tertiary: #675687;
    tertiary-fixed: #ebddff;
    tertiary-fixed-dim: #d2bdf6;
    on-tertiary: #ffffff;
    on-tertiary-fixed: #22123f;
    on-tertiary-fixed-variant: #4f3e6e;
    tertiary-container: #ebddff;
    on-tertiary-container: #22123f;
    error: #ba1a1a;
    on-error: #ffffff;
    error-container: #ffdad6;
    on-error-container: #410002;
    surface: #faf8ff;
    on-surface: #191b25;
    on-surface-variant: #444651;
    outline: #747682;
    outline-variant: #c4c6d3;
    shadow: #000000;
    scrim: #000000;
    inverse-surface: #2e303a;
    inverse-on-surface: #eff0fe;
    inverse-primary: #b4c5ff;
    surface-dim: #d8d9e7;
    surface-bright: #faf8ff;
    surface-container-lowest: #ffffff;
    surface-container-low: #f2f3ff;
    surface-container: #ecedfb;
    surface-container-high: #e6e7f5;
    surface-container-highest: #e1e1ef;
