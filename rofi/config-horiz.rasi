@import "colors.rasi"

configuration {
/* OGANESSON_FONT_START */
    font:                   "Zalando Sans 10";
/* OGANESSON_FONT_END */
    show-icons:             true;
    icon-theme:             "Papirus-Dark";
    drun-display-format:    "{name}";
    hover-select:           true;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
    drun-match-fields:      "name,generic,exec,categories,keywords";
    display-drun:           "";
}

* {
    text-color:             @on-surface;
    background-color:       transparent;
    font:                   "Zalando Sans 10";
}

/* ── Bottom-anchored panel: shared frame with config.rasi ── */
window {
    background-color:       @surface-container;
    border:                 1px;
    border-color:           @outline-variant;
    border-radius:          0;
    width:                  560px;
    location:               south;
    anchor:                 south;
    y-offset:               -10px;
    shadow:                 true;
    shadow-radius:          0;
    shadow-offset:          4px 4px;
    shadow-color:           @surface-container-highest;
    children:               [ mainbox ];
}

/* ── Swapped stack: list rises above, search sits at the base ── */
mainbox {
    orientation:            vertical;
    background-color:       transparent;
    padding:                6px;
    spacing:                6px;
    children:               [ listview, inputbar ];
}

/* ── Search bar: shared with config.rasi ────────────────── */
inputbar {
    background-color:       @surface-container-high;
    border:                 1px;
    border-color:           @outline-variant;
    text-color:             @on-surface;
    border-radius:          0;
    padding:                5px 10px;
    margin:                 0;
    spacing:                8px;
    children:               [ prompt, entry ];
}

prompt {
    text-color:             @primary;
/* OGANESSON_FONT_BOLD_START */
    font:                   "Zalando Sans Bold 10";
/* OGANESSON_FONT_BOLD_END */
    expand:                 false;
    vertical-align:         0.5;
}

entry {
    text-color:             @on-surface;
    font:                   "Zalando Sans SemiExpanded Bold 16";
    placeholder:            "Search apps...";
    placeholder-color:      @on-surface-variant;
    cursor-color:           @primary;
    vertical-align:         0.5;
}

/* ── App list: transparent so it sits on the panel ──────── */
listview {
    layout:                 vertical;
    background-color:       transparent;
    border:                 0;
    border-radius:          0;
    padding:                0;
    margin:                 0;
    spacing:                1px;
    cycle:                  true;
    dynamic:                true;
    scrollbar:              true;
    lines:                  10;
    columns:                1;
}

scrollbar {
    width:                  3px;
    handle-width:           3px;
    handle-color:           @outline-variant;
    background-color:       transparent;
    border:                 0;
    border-radius:          0;
    padding:                0;
    margin:                 0 0 0 8px;
}

/* ── Rows: shared with config.rasi ──────────────────────── */
element {
    background-color:       transparent;
    text-color:             @on-surface-variant;
    border:                 0 0 0 2px;
    border-color:           transparent;
    border-radius:          0;
    padding:                5px 10px;
    spacing:                10px;
    orientation:            horizontal;
}

element-icon {
    size:                   22px;
    vertical-align:         0.5;
}

element-text {
    text-color:             inherit;
    font:                   "Zalando Sans 10";
    vertical-align:         0.5;
}

/* selected: primary-container fill with a primary accent edge */
element selected {
    background-color:       @primary-container;
    text-color:             @on-primary-container;
    border-color:           @primary;
    font:                   "Zalando Sans Bold 10";
}

element selected element-text {
    font:                   "Zalando Sans Bold 10";
}

element normal active {
    text-color:             @primary;
}

element selected active {
    text-color:             @on-primary-container;
}

element urgent element-text {
    font:                   "Zalando Sans Bold 10";
}

element selected urgent element-text {
    font:                   "Zalando Sans Bold 10";
}
